---
import Icon from './Icon.astro';
import Brand from './Brand.astro';
---
<div class="reading-progress" aria-hidden="true">
  <div class="reading-progress-bar">
  </div>
</div>
<div class="topbar">
  <div class="site-container topbar-inner">
    <span>
      <Icon name="pin" /> ITAQUAQUECETUBA, SP</span>
    <p>Paixão por carros. Conexão com você.</p>
    <a href="https://www.instagram.com/v4machines/" target="_blank" rel="noopener noreferrer">
      <Icon name="instagram" />
      <span>@v4machines</span>
    </a>
  </div>
</div>
<header class="site-header">
  <div class="site-container navigation flex items-center justify-between">
    <Brand />
    <nav class="desktop-nav" aria-label="Navegação principal">
      <a href="#veiculos">Nossos veículos</a>
      <a href="#sobre">A V4 Machines</a>
      <a href="#experiencia">Sua experiência</a>
    </nav>
    <div class="nav-actions">
      <button id="favorites-toggle" class="favorites-nav" type="button" aria-label="Ver meus veículos favoritos" aria-pressed="false">
        <Icon name="heart" />
        <span>Favoritos</span>
        <small class="favorite-count" data-favorites-count>0</small>
      </button>
      <a class="button button-dark nav-contact" data-whatsapp href="https://wa.me/5511945194285" target="_blank" rel="noopener noreferrer">Vamos conversar <Icon name="diagonal" />
      </a>
      <button class="menu-toggle" id="mobile-menu-toggle" type="button" aria-controls="mobile-menu" aria-expanded="false" aria-label="Abrir menu">
        <Icon name="menu" />
      </button>
    </div>
  </div>
  <nav id="mobile-menu" class="mobile-menu" aria-label="Navegação móvel" hidden>
    <a href="#veiculos">Nossos veículos</a>
    <a href="#sobre">A V4 Machines</a>
    <a href="#experiencia">Sua experiência</a>
    <a href="#contato">Visite a loja</a>
  </nav>
</header>
