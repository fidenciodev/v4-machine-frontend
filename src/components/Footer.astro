---
import Icon from './Icon.astro';
import Brand from './Brand.astro';
---
<footer class="footer">
  <div class="site-container">
    <div class="footer-top">
      <Brand light />
      <p>Movidos pela sua<br>
        <em>próxima conquista.</em>
      </p>
      <a class="social-link" href="https://www.instagram.com/v4machines/" target="_blank" rel="noopener noreferrer" aria-label="Instagram da V4 Machines">
        <Icon name="instagram" />
        <Icon name="diagonal" />
      </a>
    </div>
    <div class="footer-bottom">
      <span>© <span id="current-year">2026</span> V4 Machines. Todos os direitos reservados.</span>
      <nav aria-label="Links do rodapé">
        <a href="#veiculos">Veículos</a>
        <a href="#sobre">Sobre a V4</a>
        <a href="#contato">Contato</a>
      </nav>
      <span class="prototype-label">V4 MACHINES · ITAQUAQUECETUBA, SP</span>
    </div>
  </div>
</footer>
<a class="floating-contact" data-whatsapp href="https://wa.me/5511945194285" target="_blank" rel="noopener noreferrer" aria-label="Conversar com a V4 Machines no WhatsApp">
  <Icon name="whatsapp" />
  <span>Vamos conversar?</span>
</a>
