---
import Icon from './Icon.astro';
import VehicleCard from './VehicleCard.astro';
import stock from '../data/stock.json';
---
<section id="veiculos" class="inventory section-pad" aria-labelledby="inventory-title">
  <div class="site-container">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow">
          <span>
          </span> ESCOLHAS QUE MOVEM</p>
        <h2 id="inventory-title">Encontre o seu<br>
          <span>próximo destino.</span>
        </h2>
      </div>
      <div class="section-intro">
        <p>Personalidades diferentes.<br>A mesma vontade de ir além.</p>
        <a class="text-link" href="#inventory-filters">Encontre o seu <Icon name="arrow" />
        </a>
      </div>
    </div>
    <div class="demo-notice">
      <span class="demo-dot">
      </span>
      <span>SELEÇÃO DEMONSTRATIVA</span>
      <p>Veículos e valores ilustrativos desta proposta. Consulte o estoque atual com a loja.</p>
    </div>
    <div id="inventory-filters" class="inventory-filters">
      <div class="filter-row">
        <label class="search-field">
          <Icon name="search" />
          <span class="sr-only">Buscar por marca ou modelo</span>
          <input id="search-input" type="search" placeholder="Qual carro faz o seu estilo?" autocomplete="off">
        </label>
        <label class="select-field">
          <span>MARCA</span>
          <select id="brand-filter" aria-label="Filtrar por marca">
            <option value="">Todas as marcas</option>
          </select>
        </label>
        <label class="select-field">
          <span>INVESTIMENTO</span>
          <select id="price-filter" aria-label="Filtrar por preço">
            <option value="">Todas as faixas</option>
            <option value="200000">Até R$ 200 mil</option>
            <option value="350000">Até R$ 350 mil</option>
            <option value="500000">Até R$ 500 mil</option>
            <option value="800000">Até R$ 800 mil</option>
          </select>
        </label>
        <button class="button button-dark filter-search" type="button" id="search-submit" aria-label="Ver veículos que correspondem à busca">
          <Icon name="search" />
          <span>Buscar</span>
        </button>
      </div>
      <div class="categories-row">
        <div class="category-tabs" role="group" aria-label="Categoria do veículo">
          <button type="button" data-category="all" class="is-active" aria-pressed="true">Todos os estilos</button>
          <button type="button" data-category="suv" aria-pressed="false">SUVs</button>
          <button type="button" data-category="sedan" aria-pressed="false">Sedãs</button>
          <button type="button" data-category="hatch" aria-pressed="false">Hatches</button>
          <button type="button" data-category="esportivo" aria-pressed="false">Esportivos</button>
        </div>
        <span class="inventory-count" id="inventory-count" aria-live="polite">{stock.cars.length} modelos para explorar</span>
      </div>
    </div>
    <div class="inventory-grid" id="inventory-grid" aria-label="Seleção de veículos">{stock.cars.slice(0, 6).map(car =>
      <VehicleCard car={car} />)}</div>
    <div id="empty-state" class="empty-state" hidden>
      <Icon name="search" />
      <h3>Uma nova busca, novas possibilidades.</h3>
      <p>Não encontramos veículos com esses filtros.</p>
      <button type="button" class="text-link" id="reset-filters">Limpar filtros <Icon name="arrow" />
      </button>
    </div>
    <div class="inventory-bottom">
      <p>O seu próximo carro pode estar a uma conversa de distância.</p>
      <button class="button button-outline" type="button" id="load-more">Explorar mais veículos <Icon name="arrow" />
      </button>
      <a class="text-link" href="https://wa.me/5511945194285?text=Ol%C3%A1!%20Gostaria%20de%20conhecer%20o%20estoque%20atual%20da%20V4%20Machines." target="_blank" rel="noopener noreferrer">Consulte o estoque atual <Icon name="diagonal" />
      </a>
    </div>
  </div>
</section>
